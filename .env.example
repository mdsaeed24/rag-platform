DEEPSEEK_API_KEY=your-deepseek-api-key
# Provider I/O timeout in seconds; SDK automatic retries are disabled.
LLM_TIMEOUT_SECONDS=30
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Disable answer reuse while debugging retrieval/generation.
ANSWER_CACHE_ENABLED=true
# Routing still requires authenticated, ACL-filtered retrieval on every request.
QUERY_ROUTING_ENABLED=true
ROUTING_MIN_SCORE=0.25
# Request-local salary/policy graph.
GRAPH_RAG_ENABLED=true
# Reuse graph answers only after fresh authorized retrieval and traversal.
GRAPH_ANSWER_CACHE_ENABLED=true
# Process-local admission limits; no queue when all slots are busy.
MAX_INFLIGHT_ASK=4
MAX_INFLIGHT_LOGIN=4
MAX_REQUEST_BODY_BYTES=16384
# Disabled when empty. Set an independent random token of at least 32 characters.
METRICS_TOKEN=
